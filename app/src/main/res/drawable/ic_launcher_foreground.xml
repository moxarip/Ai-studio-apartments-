<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54">
        <!-- Vertical Phone Frame (9:16 portrait) -->
        <path
            android:pathData="M40,26 L68,26 A6,6 0 0,1 74,32 L74,76 A6,6 0 0,1 68,82 L40,82 A6,6 0 0,1 34,76 L34,32 A6,6 0 0,1 40,26 Z"
            android:strokeWidth="3.2"
            android:strokeColor="#6366F1"
            android:fillColor="#18182E" />

        <!-- Phone screen notch / pill -->
        <path
            android:pathData="M50,30 L58,30"
            android:strokeWidth="2"
            android:strokeColor="#818CF8"
            android:strokeLineCap="round" />

        <!-- Central Play Triangle with Gradient -->
        <path
            android:pathData="M49,46 L62,54 L49,62 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="49"
                    android:startY="46"
                    android:endX="62"
                    android:endY="62"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#F59E0B" />
                    <item android:offset="1.0" android:color="#EF4444" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Forge Spark / AI Magic Star at Top-Right -->
        <path
            android:pathData="M70,34 L72,28 L74,34 L80,36 L74,38 L72,44 L70,38 L64,36 Z"
            android:fillColor="#FBBF24" />

        <!-- Accent Spark at Bottom-Left -->
        <path
            android:pathData="M32,68 L33.5,64 L35,68 L39,69.5 L35,71 L33.5,75 L32,71 L28,69.5 Z"
            android:fillColor="#38BDF8" />
    </group>
</vector>
