{
  "name": "shortsforge-backend",
  "version": "1.0.0",
  "description": "ShortsForge AI - Production-grade full-stack video-to-shorts platform with Gemini Pro, FFmpeg, and BullMQ",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
