# ShortsForge AI Environment Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://shortsforge:forge_secret_2026@localhost:5432/shortsforge_db
REDIS_URL=redis://localhost:6379

# Google Gemini API (Required for video understanding & highlight detection)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# YouTube Data API (Optional for official metadata enrichment)
YOUTUBE_DATA_API_KEY=YOUR_YOUTUBE_DATA_API_KEY

# Object Storage (S3 / MinIO / Cloud Storage)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=shortsforge-media
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=us-east-1

# Security & Sessions
SESSION_SECRET=super_secure_session_secret_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Media Limits
MAX_SOURCE_SIZE_MB=500
MAX_SOURCE_DURATION_SECONDS=1800
TEMP_MEDIA_DIRECTORY=/tmp/shortsforge
